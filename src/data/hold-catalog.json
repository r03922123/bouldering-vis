  {
    "id": "pocket",
    "name": "Pocket",
    "grip": "Fit one to three fingers in the hole, strongest fingers first; pull straight, not sideways.",
    "learn": {
      "mistake": "Twisting your fingers sideways in the hole, which strains them. Pull in line with the pocket.",
      "footUse": "Put your toe in the hole and keep the foot still.",
