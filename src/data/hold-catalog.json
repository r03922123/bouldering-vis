  {
    "id": "standard",
    "name": "Standard",
    "grip": "The hold faces up: pull down on it with your arm straight below it."
  },
  {
    "id": "sidepull",
    "name": "Sidepull",
    "grip": "The hold faces sideways: lean away from it and pull sideways, with the opposite foot pushing."
  },
  {
    "id": "undercling",
    "name": "Undercling",
    "grip": "The hold faces down: palm up, pull upward, and get your feet high to load it."
  }
]
