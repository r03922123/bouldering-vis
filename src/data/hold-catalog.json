  {
    "id": "crimp",
    "name": "Crimp",
    "grip": "Half-crimp by default: fingertips on the edge, middle joints bent ~90°, thumb free. A full crimp (thumb over the index) adds power but loads finger pulleys most; save it for hard moves.",
    "learn": {
      "mistake": "Full-crimping everything, which loads the finger pulleys. Half-crimp unless you need the extra power.",
      "footUse": "Place the tip of your shoe and keep your heel still so it doesn’t roll off.",
      "examples": [
        {
          "src": "/learn/crimp-1.webp",
          "credit": "Sample wall photo (this project)",
          "license": "project",
          "sourceUrl": "https://bouldering-vis.pages.dev/samples/t-up-d2.jpg"
        },
        {
          "src": "/learn/crimp-2.webp",
          "credit": "Sample wall photo (this project)",
          "license": "project",
          "sourceUrl": "https://bouldering-vis.pages.dev/samples/t-up-d2.jpg"
        },
