  {
    "id": "pinch",
    "name": "Pinch",
    "grip": "Squeeze between thumb and fingers; the thumb does half the work.",
    "learn": {
      "mistake": "Forgetting the thumb. Without the squeeze, a pinch feels like a bad sloper.",
      "footUse": "Toe on its top, or hook it with your heel or toe.",
