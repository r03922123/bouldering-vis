          "credit": "Sample wall photo (this project)",
          "license": "project",
          "sourceUrl": "https://bouldering-vis.pages.dev/samples/t-up-d2.jpg"
        }
      ]
    }
  },
  {
    "id": "edge",
    "name": "Edge",
    "grip": "Flat rail: use an open hand or half-crimp, and keep your weight under the edge.",
    "learn": {
      "mistake": "Letting your hips drift away from the wall, which peels you off the edge.",
      "footUse": "Stand on it with the inside edge of your big toe and press straight down.",
      "examples": [
        {
