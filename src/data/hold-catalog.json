  {
    "id": "volume",
    "name": "Volume",
    "grip": "Big shape bolted to the wall: use its edges and faces as holds and smear your feet on it.",
    "learn": {
      "mistake": "Ignoring it. A volume adds many edges and smears: look at all its faces before you climb.",
      "footUse": "Smear on any face or stand on its edges; often the best foothold around.",
